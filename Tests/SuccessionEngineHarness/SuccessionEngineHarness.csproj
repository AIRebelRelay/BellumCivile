    <UIExtenderExDllPath Condition="'$(UIExtenderExDllPath)' == '' and Exists('$(GameFolder)/../../workshop/content/261550/2859222409/bin/Win64_Shipping_Client/Bannerlord.UIExtenderEx.dll')">$(GameFolder)/../../workshop/content/261550/2859222409/bin/Win64_Shipping_Client/Bannerlord.UIExtenderEx.dll</UIExtenderExDllPath>
    <UIExtenderExDllPath Condition="'$(UIExtenderExDllPath)' == ''">$(GameFolder)/Modules/Bannerlord.UIExtenderEx/bin/Win64_Shipping_Client/Bannerlord.UIExtenderEx.dll</UIExtenderExDllPath>
