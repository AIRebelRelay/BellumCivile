    <Reference Include="0Harmony" HintPath="$(HarmonyDllPath)" />
    <Reference Include="TaleWorlds.CampaignSystem" HintPath="$(GameFolder)/bin/Win64_Shipping_Client/TaleWorlds.CampaignSystem.dll" />
