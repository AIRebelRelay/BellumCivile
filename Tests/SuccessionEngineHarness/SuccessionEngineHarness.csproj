<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <!-- Keep the harness aligned with the shipping project's optional reference paths. -->
    <!-- Explicit -p:*DllPath always wins; standard Modules first, official Steam Workshop second. -->
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == '' and Exists('$(GameFolder)/Modules/Bannerlord.Harmony/bin/Win64_Shipping_Client/0Harmony.dll')">$(GameFolder)/Modules/Bannerlord.Harmony/bin/Win64_Shipping_Client/0Harmony.dll</HarmonyDllPath>
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == '' and Exists('$(GameFolder)/../../workshop/content/261550/2859188632/bin/Win64_Shipping_Client/0Harmony.dll')">$(GameFolder)/../../workshop/content/261550/2859188632/bin/Win64_Shipping_Client/0Harmony.dll</HarmonyDllPath>
